# ---------------------------------------------------------------------------
# SINGLE SOURCE OF TRUTH for every IP in this project.
#
# This is a shared mobile hotspot: IPs change on every reconnect. When that
# happens, DO NOT hand-edit configs. Edit this file, then run:
#
#     ./scripts/set-ips.sh
#
# ...which rewrites dnsmasq.conf, nginx.conf, the backup DNS config, the
# firewall rules and the standby edge config from this one table.
#
# Get each machine's current IP with:  ipconfig getifaddr en0
# ---------------------------------------------------------------------------

DOMAIN=cn_team.test

# Mac 1 — Naman — primary DNS (dnsmasq)
MAC1_IP=10.7.20.236

# Mac 2 — Harsha — edge / nginx / TLS / load balancer   (PRIMARY EDGE)
MAC2_IP=10.7.11.169

# Mac 3 — Hemanth — Backend A :3001  +  BACKUP DNS (Phase 2 Ext A)
MAC3_IP=10.7.25.47

# Mac 4 — Akshay — Backend B :3002  +  STANDBY EDGE :443 (Phase 2 Ext E)
MAC4_IP=10.7.21.77   # <-- STALE, waiting on Akshay

# Ports (Phase 1 values; change only if a machine refuses to bind)
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
EDGE_HTTPS_PORT=443
EDGE_HTTP_PORT=80

# DNS TTL used for the Phase 2 Extension B demo (seconds)
DNS_TTL=30
