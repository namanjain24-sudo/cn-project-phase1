# dnsmasq config for the team's private DNS server (Mac 1)
# Copy this to your real config location and rename without ".template",
# then replace the placeholders below with your actual values.

# --- Private DNS records ---
# Replace team1.test with your real team domain (see repo root README step 0)
# Replace <MAC2_IP> with Mac 2's actual LAN IP from docs/topology.md
address=/app.team1.test/<MAC2_IP>
address=/api.team1.test/<MAC2_IP>

# --- Listen configuration ---
# Replace <MAC1_IP> with this machine's own LAN IP
listen-address=127.0.0.1,<MAC1_IP>
bind-interfaces
port=53

# --- Forward everything else to a real upstream resolver ---
# so this machine (and clients using it) can still browse the normal internet
server=8.8.8.8
server=1.1.1.1

# --- Logging (helpful for the demo — shows queries arriving live) ---
log-queries
log-facility=/opt/homebrew/var/log/dnsmasq.log
